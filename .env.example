# Tool 02: Expansion Signal Desk. Copy to .env and fill in.
# Fixed local ports (see /PORTS.md). Do not change: app 3002 · Postgres 5402 · mail inbox 4002 · SMTP 2502

# App
APP_URL=http://localhost:3002
CLIENT_CONFIG=demo                       # loads config/clients/<name>.json when seeding

# Database (docker compose up -d)
DATABASE_URL=postgres://esd:esd@localhost:5402/signal_desk
TEST_DATABASE_URL=postgres://esd:esd@localhost:5402/signal_desk_test

# Auth: 32+ random characters (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=

# Scheduled jobs: bearer secret for /api/cron/*
CRON_SECRET=

# Email: smtp | resend | disabled (Mailpit inbox at http://localhost:4002)
EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:2502
RESEND_API_KEY=
EMAIL_FROM="Signal Desk <no-reply@localhost>"

LOG_LEVEL=info

# First administrator for a real deployment (npm run db:seed -- --org-only).
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
