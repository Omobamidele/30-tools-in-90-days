# Tool 01: Exposure Register. Copy to .env and fill in.
# Fixed local ports (see /PORTS.md). Do not change: app 3001 · Postgres 5401 · mail inbox 4001 · SMTP 2501

# App
APP_URL=http://localhost:3001
CLIENT_CONFIG=demo                       # loads config/clients/<name>.json when seeding

# Database (docker compose up -d)
DATABASE_URL=postgres://er:er@localhost:5401/exposure_register
TEST_DATABASE_URL=postgres://er:er@localhost:5401/exposure_register_test

# Auth: 32+ random characters (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=

# Scheduled jobs: bearer secret for /api/cron/*
CRON_SECRET=
# Inbound hotel pickup reports: webhook bearer secret (16+ chars) and the address domain.
# Locally, npm run inbound:mailpit forwards mail sent to *@INBOUND_DOMAIN from Mailpit.
INBOUND_SECRET=
INBOUND_DOMAIN=inbound.localhost

# File storage: local | vercel-blob
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
BLOB_READ_WRITE_TOKEN=

# Email: smtp | resend | disabled (Mailpit inbox at http://localhost:4001)
EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:2501
RESEND_API_KEY=
EMAIL_FROM="Exposure Register <no-reply@localhost>"

# Contract term extraction (optional; manual entry works without it)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

LOG_LEVEL=info

# First administrator for a real deployment (npm run db:seed -- --org-only). A temporary
# password is printed once; change it at /account after signing in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
